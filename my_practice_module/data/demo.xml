<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Demo Data for Practice Tasks -->
    <record id="demo_task_1" model="practice.task">
        <field name="name">Learn Odoo Models</field>
        <field name="description">Study how to create and define models in Odoo, including field types and relationships.</field>
        <field name="priority">2</field>
        <field name="state">done</field>
    </record>

    <record id="demo_task_2" model="practice.task">
        <field name="name">Create Custom Views</field>
        <field name="description">Practice creating tree, form, and search views for your models.</field>
        <field name="priority">2</field>
        <field name="state">in_progress</field>
    </record>

    <record id="demo_task_3" model="practice.task">
        <field name="name">Implement Business Logic</field>
        <field name="description">Add methods and actions to your models to handle business processes.</field>
        <field name="priority">1</field>
        <field name="state">draft</field>
    </record>

    <record id="demo_task_4" model="practice.task">
        <field name="name">Setup Security</field>
        <field name="description">Learn how to configure access rights and record rules in Odoo.</field>
        <field name="priority">1</field>
        <field name="state">draft</field>
    </record>

    <record id="demo_task_5" model="practice.task">
        <field name="name">Explore Inheritance</field>
        <field name="description">Understand the different types of inheritance in Odoo: class, prototype, and delegation.</field>
        <field name="priority">3</field>
        <field name="state">draft</field>
    </record>

</odoo>
